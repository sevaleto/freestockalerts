# FreeStockAlerts.AI — environment variables
# Copy to .env.local for local dev, or pull the real values from Vercel:
#   vercel link --project freestockalerts && vercel env pull .env.local
#
# NOTE: the Vercel "development" environment points at the PRODUCTION database.
# Local `npm run dev` reads/writes live user data. Be deliberate.

# --- Database (Supabase Postgres via Prisma) ---
DATABASE_URL=""            # pooled connection (pgbouncer, port 6543) — runtime
DIRECT_URL=""              # direct connection (port 5432) — prisma migrate only

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # REQUIRED: mints magic-link tokens in /api/auth/magic-link

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # used in auth redirects + email links
CRON_SECRET=""             # optional; when set, /api/alerts/check requires
                           # "Authorization: Bearer <CRON_SECRET>". Vercel sends it automatically.
ADMIN_EMAILS=""            # comma-separated sign-in emails allowed into /admin (email ads).
                           # Unset = manuel@tradingtips.com, sevaleto@gmail.com, chelsie@trading-tips.us,
                           # nicole@trading-tips.us (lib/auth/admin.ts). Setting it replaces that list.

# --- Bot protection (Cloudflare Turnstile) ---
# Create a widget at https://dash.cloudflare.com → Turnstile (managed mode, hostnames: freestockalerts.ai, www.freestockalerts.ai).
# Both unset = widget hidden and verification skipped. Set BOTH in Vercel Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Market data ---
FMP_API_KEY=""             # Financial Modeling Prep (quotes, search, RSI/SMA, earnings)
ALPHA_VANTAGE_API_KEY=""   # fallback quotes only

# --- AI context paragraphs (Anthropic) ---
ANTHROPIC_API_KEY=""       # writes the two-paragraph context in alert and signal emails (claude-haiku-4-5,
                           # see lib/ai/config.ts). Unset = deterministic fallback text, no model call.

# --- Email (Resend) ---
RESEND_API_KEY=""
RESEND_FROM="FreeStockAlerts <alerts@freestockalerts.ai>"
RESEND_AUDIENCE_ID=""      # broadcast audience for blasts
RESEND_WEBHOOK_SECRET=""   # whsec_… signing secret for /api/webhooks/resend (bounces, complaints, unsubscribes)

# Email Oversight real-time validation (https://emailoversight.com/docs-api/). Unset = addresses stay PENDING.
EMAIL_OVERSIGHT_API_TOKEN=""
EMAIL_OVERSIGHT_LIST_ID=""     # numeric list id from the Lists menu

# --- Public forms (/advertise, /do-not-sell) — all optional ---
ADVERTISER_INQUIRY_TO=""       # comma-separated; default chelsie@trading-tips.us
ADVERTISER_INQUIRY_BCC=""      # default manuel@tradingtips.com
PRIVACY_ALERT_EMAILS=""        # default manuel@tradingtips.com, chelsie@trading-tips.us, nicole@trading-tips.us
IP_HASH_SALT=""                # salts the sha256 stored with each form submission (no raw IPs are kept)

# --- Subscribers and cohorts (Beehiiv) ---
BEEHIIV_API_KEY=""             # Beehiiv API key with posts READ + WRITE (drafts) and subscriptions read;
                               # unset = /api/subscribers/sync and /api/newsletter/build return 503
BEEHIIV_PUB_FSA=""             # optional override; default pub id for FreeStockAlerts.AI is in lib/beehiiv/config.ts
BEEHIIV_PUB_SI=""              # optional override; default pub id for The Smart Investor

# --- Tracking (optional) ---
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_GA_ID=""

# --- Daily newsletter drafts (lib/newsletter) ---
NEWSLETTER_REPORT_TO=""        # comma-separated recipients of the run report; default sevaleto@gmail.com,manuel@tradingtips.com
