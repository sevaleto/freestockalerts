# FreeStockAlerts.AI — environment variables
# Copy to .env.local for local dev, or pull the real values from Vercel:
#   vercel link --project freestockalerts && vercel env pull .env.local
#
# NOTE: the Vercel "development" environment points at the PRODUCTION database.
# Local `npm run dev` reads/writes live user data. Be deliberate.

# --- Database (Supabase Postgres via Prisma) ---
DATABASE_URL=""            # pooled connection (pgbouncer, port 6543) — runtime
DIRECT_URL=""              # direct connection (port 5432) — prisma migrate only

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # REQUIRED: mints magic-link tokens in /api/auth/magic-link

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # used in auth redirects + email links
CRON_SECRET=""             # optional; when set, /api/alerts/check requires
                           # "Authorization: Bearer <CRON_SECRET>". Vercel sends it automatically.
AB_RESULTS_SECRET=""       # optional; protects GET /api/ab/results

# --- Bot protection (Cloudflare Turnstile) ---
# Create a widget at https://dash.cloudflare.com → Turnstile (managed mode, hostnames: freestockalerts.ai, www.freestockalerts.ai).
# Both unset = widget hidden and verification skipped. Set BOTH in Vercel Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Market data ---
FMP_API_KEY=""             # Financial Modeling Prep (quotes, search, RSI/SMA, earnings)
ALPHA_VANTAGE_API_KEY=""   # fallback quotes only

# --- AI summaries ---
OPENAI_API_KEY=""          # gpt-4o-mini alert summaries; falls back to plain text if unset

# --- Email (Resend) ---
RESEND_API_KEY=""
RESEND_FROM="FreeStockAlerts <alerts@freestockalerts.ai>"
RESEND_AUDIENCE_ID=""      # broadcast audience for blasts
RESEND_WEBHOOK_SECRET=""   # whsec_… signing secret for /api/webhooks/resend (bounces, complaints, unsubscribes)

# --- Tracking (optional) ---
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
NEXT_PUBLIC_GA_ID=""
