generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  firstName              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  emailVerified          Boolean                @default(false)
  alertsCount            Int                    @default(0)
  maxAlerts              Int                    @default(50)
  unsubscribedFromBlasts Boolean                @default(false)
  resendContactId        String?
  signupVariant          String? // headline variant seen at signup: "<page slug>:<key>", e.g. "home:B" or "radar:A"
  signupSource           String? // which form captured the lead: hero | final-cta | template-preview | login | google
  lastLinkSentAt         DateTime? // last magic-link email; rate-limits resends to one per 60s
  emailStatus            EmailStatus            @default(PENDING) // deliverability verdict; gates the Resend audience and lead exports
  emailVerdict           String? // raw verdict: Email Oversight Result name, or magic-link | google | bounce | complaint | precheck:<reason>
  emailCheckedAt         DateTime? // when emailStatus was last written
  emailCheckAttempts     Int                    @default(0) // Email Oversight calls made (Retry/Unknown are retried up to 3 times)
  // First-touch acquisition data captured at signup (URL params on the page the lead converted on).
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmTerm                String?
  utmContent             String?
  fbclid                 String?
  landingPath            String?
  referrer               String?
  alerts                 Alert[]
  subscriber             Subscriber?
  templateSubs           TemplateSubscription[]
  preferences            UserPreferences?

  @@index([emailStatus])
}

/// Deliverability verdict for a lead's address. Only VALID and ACCEPT_ALL are mailable.
enum EmailStatus {
  PENDING // not checked yet, or Email Oversight said Retry/Unknown (retried by cron)
  VALID // Email Oversight "Verified", or the user confirmed via magic link / Google
  ACCEPT_ALL // catch-all domain: probably fine for the newsletter, not good enough to share
  RISKY // role account, or still unknown after all retries
  INVALID // undeliverable, malformed, disposable, bot, or hard-bounced
  SUPPRESSED // spam trap, complainer, seed, suppression list, or a Resend complaint
}

model UserPreferences {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts         Boolean @default(true)
  dailyDigest         Boolean @default(false)
  digestTime          String  @default("08:00")
  timezone            String  @default("America/New_York")
  marketOpenReminder  Boolean @default(false)
  marketCloseReminder Boolean @default(false)
}

model Alert {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker           String
  companyName      String?
  alertType        AlertType
  triggerValue     Float
  triggerDirection TriggerDirection
  currentPrice     Float?
  isActive         Boolean          @default(true)
  isTriggered      Boolean          @default(false)
  triggeredAt      DateTime?
  lastCheckedAt    DateTime?
  cooldownMinutes  Int              @default(20)
  note             String?
  templateId       String?
  template         AlertTemplate?   @relation(fields: [templateId], references: [id])
  history          AlertHistory[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, isActive])
  @@index([ticker, isActive])
  @@index([isActive, isTriggered])
}

/// Per-IP request counter for the signup route (fixed 60s windows).
model SignupRateLimit {
  ip          String
  windowStart DateTime
  count       Int      @default(1)

  @@id([ip, windowStart])
  @@index([windowStart])
}

model AlertHistory {
  id             String    @id @default(cuid())
  alertId        String
  alert          Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  triggeredAt    DateTime  @default(now())
  priceAtTrigger Float
  aiSummary      String?
  emailSent      Boolean   @default(false)
  emailSentAt    DateTime?
}

model AlertTemplate {
  id              String                 @id @default(cuid())
  name            String
  slug            String                 @unique
  description     String
  longDescription String?
  category        TemplateCategory
  iconEmoji       String                 @default("📊")
  isActive        Boolean                @default(true)
  isFeatured      Boolean                @default(false)
  sortOrder       Int                    @default(0)
  /// Catalog section shown on the index and on every strategy page.
  section         StrategySection        @default(IDEA_DISCOVERY)
  /// One line describing the final alert trigger, e.g. "Fresh 52-week high".
  triggerSummary  String?
  /// Human cadence, e.g. "Monthly", "Weekly", "Weekly in earnings season, biweekly otherwise".
  refreshCadence  String?
  /// When the constituent list was last rebuilt or reviewed.
  lastRefreshedAt DateTime?
  /// Bumped when the strategy's rules change.
  version         Int                    @default(1)
  /// Retired templates stay in the table so existing user alerts keep their reference.
  retiredAt       DateTime?
  /// Slug of the strategy that replaced a retired template.
  replacedBySlug  String?
  alerts          Alert[]
  items           TemplateItem[]
  subscriptions   TemplateSubscription[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model TemplateItem {
  id               String           @id @default(cuid())
  templateId       String
  template         AlertTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ticker           String
  companyName      String?
  alertType        AlertType
  triggerValue     Float
  triggerDirection TriggerDirection
  rationale        String?
  sortOrder        Int              @default(0)
}

model TemplateSubscription {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     AlertTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  isActive     Boolean       @default(true)
  subscribedAt DateTime      @default(now())

  @@unique([userId, templateId])
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE_DAY
  PERCENT_CHANGE_CUSTOM
  VOLUME_SPIKE
  RSI_OVERBOUGHT
  RSI_OVERSOLD
  SMA_CROSS_ABOVE
  SMA_CROSS_BELOW
  FIFTY_TWO_WEEK_HIGH
  FIFTY_TWO_WEEK_LOW
  EARNINGS_REMINDER
  PRICE_RECOVERY
}

enum TriggerDirection {
  ABOVE
  BELOW
  BOTH
}

/// The three catalog sections. `TemplateCategory` below is the older topical tag and is kept for compatibility.
enum StrategySection {
  IDEA_DISCOVERY
  ENTRY_TIMING
  MARKET_MONITORING
}

enum TemplateCategory {
  EARNINGS
  VALUE_INVESTING
  MOMENTUM
  DIVIDEND
  MACRO
  AI_PICKS
}

// ---------------------------------------------------------------------------
// Event-driven strategies (insider purchases, analyst clusters). Source rows are
// normalized copies of what the data provider returned so every signal can be
// explained and reproduced; signals are idempotent on signalKey; deliveries
// are unique per signal + user so a re-run never emails twice.
// ---------------------------------------------------------------------------

/// One line of a Form 4 (or similar) as normalized from the provider.
model InsiderTransaction {
  id                       String    @id @default(cuid())
  symbol                   String
  /// accession + transaction details; stable across re-fetches
  dedupKey                 String    @unique
  accession                String?
  insiderName              String
  insiderTitle             String?
  /// raw "typeOfOwner" string, e.g. "director, officer: CEO"
  ownerType                String?
  isDirector               Boolean   @default(false)
  isOfficer                Boolean   @default(false)
  isSenior                 Boolean   @default(false)
  transactionCode          String
  acquisitionOrDisposition String?
  securityName             String?
  transactionDate          DateTime
  filingDate               DateTime?
  shares                   Float
  price                    Float
  value                    Float
  sharesOwnedAfter         Float?
  filingUrl                String?
  raw                      Json
  fetchedAt                DateTime  @default(now())

  @@index([symbol, transactionDate])
  @@index([transactionDate])
}

/// One analyst rating action as normalized from the provider.
model AnalystAction {
  id            String   @id @default(cuid())
  symbol        String
  /// symbol|firm|date|previousGrade|newGrade
  dedupKey      String   @unique
  firm          String
  actionDate    DateTime
  previousGrade String?
  newGrade      String?
  /// provider's action word (upgrade, downgrade, maintain, initiate, ...)
  action        String?
  previousTier  String?
  newTier       String?
  /// POSITIVE | NEGATIVE | NEUTRAL, derived from the tiers
  direction     String
  isTrueUpgrade Boolean  @default(false)
  sourceUrl     String?
  raw           Json
  fetchedAt     DateTime @default(now())

  @@index([symbol, actionDate])
  @@index([actionDate])
}

/// A confirmed strategy event. Subscribers of the strategy's template are emailed once per signal.
model StrategySignal {
  id           String           @id @default(cuid())
  strategySlug String
  symbol       String
  companyName  String?
  /// strategy + symbol + event identity; a re-run of the scan cannot create it twice
  signalKey    String           @unique
  score        Int
  price        Float
  confirmation String
  explanation  String
  /// everything shown in the alert (insiders, firms, dates, ratios, links)
  payload      Json
  dataAsOf     DateTime
  createdAt    DateTime         @default(now())
  deliveries   SignalDelivery[]

  @@index([strategySlug, createdAt])
  @@index([strategySlug, symbol, createdAt])
}

model SignalDelivery {
  id        String         @id @default(cuid())
  signalId  String
  signal    StrategySignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  userId    String
  emailSent Boolean        @default(false)
  sentAt    DateTime       @default(now())

  @@unique([signalId, userId])
  @@index([userId])
}

/// One execution of the daily scan, for "last scanned" and for operations.
model StrategyScanRun {
  id             String    @id @default(cuid())
  strategySlug   String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String    @default("RUNNING")
  dryRun         Boolean   @default(false)
  candidates     Int       @default(0)
  qualified      Int       @default(0)
  signalsCreated Int       @default(0)
  emailsSent     Int       @default(0)
  error          String?

  @@index([strategySlug, startedAt])
}

// ---------------------------------------------------------------------------
// Public forms: advertiser inquiries (/advertise) and privacy opt-out requests
// (/do-not-sell). The row is written before any email goes out, so a mail
// outage costs a notification, never the record. Both mirror the tables on
// research.tradingtips.com.
// ---------------------------------------------------------------------------

model AdvertiserInquiry {
  id          String    @id @default(cuid())
  ts          DateTime  @default(now())
  name        String
  email       String
  company     String
  website     String?
  phone       String?
  message     String?
  /// Set when sales has actioned the inquiry. Null = still in the queue.
  handledAt   DateTime?
  handledNote String?
  /// Delivery to the sales inbox: pending | sent | failed | skipped (no email provider configured).
  emailStatus String    @default("pending")
  emailError  String?
  emailSentAt DateTime?
  /// sha256(salt + ip); stores no raw IP.
  ipHash      String?
  userAgent   String?

  @@index([ts])
}

/// A "Do Not Sell or Share My Personal Information" request. Carries a statutory deadline, so it is a durable, auditable record.
model PrivacyRequest {
  id            String    @id @default(cuid())
  ts            DateTime  @default(now())
  /// consumer | agent (an authorized agent filing on someone's behalf)
  requesterType String    @default("consumer")
  firstName     String
  lastName      String
  email         String
  phone         String    @default("")
  street        String?
  city          String?
  state         String?
  zip           String?
  country       String?
  details       String?
  handledAt     DateTime?
  handledNote   String?
  /// Staff notification: pending | sent | failed | skipped.
  notifyStatus  String    @default("pending")
  notifyError   String?
  notifiedAt    DateTime?
  ipHash        String?
  userAgent     String?

  @@index([ts])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Email ads: admin-created sponsored snippets rotated into the bottom of alert
// and signal emails. Rotation is fair and weighted (fewest impressions per
// unit of weight serves next), so every active ad gets its share.
// ---------------------------------------------------------------------------

model EmailAd {
  id            String         @id @default(cuid())
  /// Internal label (campaign / advertiser), never rendered.
  name          String
  /// Header line, e.g. "Special Report"; rendered with a trailing colon.
  leadIn        String
  headline      String
  /// One of the preset hex colors in lib/ads/template.ts.
  headlineColor String
  /// Plain text; blank lines separate paragraphs.
  body          String
  ctaText       String
  ctaUrl        String
  /// Optional 230px-wide image shown beside the copy.
  imageUrl      String?
  /// active | paused
  status        String         @default("active")
  weight        Int            @default(1)
  startAt       DateTime?
  endAt         DateTime?
  impressions   Int            @default(0)
  clicks        Int            @default(0)
  /// Revenue assumed per counted click, stamped on each click at click time.
  valueCents    Int            @default(250)
  lastShownAt   DateTime?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clickEvents   EmailAdClick[]

  @@index([status])
}

model EmailAdClick {
  id           String      @id @default(cuid())
  adId         String
  ad           EmailAd     @relation(fields: [adId], references: [id], onDelete: Cascade)
  ts           DateTime    @default(now())
  /// sha256(salt + ip); no raw IP stored.
  ipHash       String?
  userAgent    String?
  /// Counted toward `EmailAd.clicks`; false for bot user agents and repeat clicks within a day.
  counted      Boolean     @default(true)
  /// alert | beehiiv_fsa | beehiiv_si | unknown
  channel      String      @default("unknown")
  /// Raw subscriber token from the link (u_<userId> or Beehiiv sub_…); kept so a click can be attached later.
  token        String?
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  /// Value credited to this click (0 when not counted).
  valueCents   Int         @default(0)

  @@index([adId, ts])
  @@index([subscriberId, ts])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Subscribers: one row per email across the app and both Beehiiv newsletters,
// with first-touch attribution and the ad clicks credited to them.
// ---------------------------------------------------------------------------

model Subscriber {
  id                             String         @id @default(cuid())
  email                          String         @unique
  firstName                      String?
  userId                         String?        @unique
  user                           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appCreatedAt                   DateTime?
  beehiivFsaId                   String?        @unique
  beehiivFsaStatus               String?
  beehiivFsaCreatedAt            DateTime?
  beehiivSiId                    String?        @unique
  beehiivSiStatus                String?
  beehiivSiCreatedAt             DateTime?
  /// Lifetime click counts Beehiiv reports per subscription (every link in every issue). Refreshed each sync.
  beehiivFsaClicks               Int            @default(0)
  beehiivFsaUniqueClicks         Int            @default(0)
  beehiivSiClicks                Int            @default(0)
  beehiivSiUniqueClicks          Int            @default(0)
  /// Counts at the moment tracking started for this subscriber; clicks before that are not credited.
  beehiivFsaClicksBaseline       Int            @default(0)
  beehiivFsaUniqueClicksBaseline Int            @default(0)
  beehiivSiClicksBaseline        Int            @default(0)
  beehiivSiUniqueClicksBaseline  Int            @default(0)
  beehiivStatsAt                 DateTime?
  /// First time this subscriber's Beehiiv stats were read (the baseline moment).
  trackingStartedAt              DateTime?
  /// Earliest signup across sources; cohort month comes from this.
  firstSeenAt                    DateTime
  /// Which source the attribution below came from: app | beehiiv_fsa | beehiiv_si
  attributionSource              String?
  utmSource                      String?
  utmMedium                      String?
  utmCampaign                    String?
  utmTerm                        String?
  utmContent                     String?
  referringSite                  String?
  landingPath                    String?
  /// "<source>|<medium>|<campaign>" (lowercased); joins CohortCost.
  cohortKey                      String
  /// Alert-email ad clicks through our redirect (per-ad value stamped at click time).
  countedClicks                  Int            @default(0)
  clickValueCents                Int            @default(0)
  lastClickAt                    DateTime?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt
  clicks                         EmailAdClick[]

  @@index([cohortKey])
  @@index([firstSeenAt])
  @@index([utmSource])
}

/// Key/value admin settings, e.g. newsletterClickValueCents.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A sent Beehiiv issue with its email stats, so the admin can see which links earned the clicks.
model NewsletterPost {
  id                   String           @id
  /// fsa | si
  publication          String
  title                String
  subtitle             String?
  webUrl               String?
  publishDate          DateTime?
  recipients           Int              @default(0)
  delivered            Int              @default(0)
  uniqueOpens          Int              @default(0)
  clicks               Int              @default(0)
  uniqueClicks         Int              @default(0)
  /// Beehiiv's human-verified subset (excludes link scanners).
  verifiedClicks       Int              @default(0)
  uniqueVerifiedClicks Int              @default(0)
  syncedAt             DateTime         @default(now())
  links                NewsletterLink[]

  @@index([publication, publishDate])
}

model NewsletterLink {
  id                   String         @id @default(cuid())
  postId               String
  post                 NewsletterPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url                  String
  baseUrl              String
  emailClicks          Int            @default(0)
  emailUniqueClicks    Int            @default(0)
  verifiedClicks       Int            @default(0)
  uniqueVerifiedClicks Int            @default(0)
  webClicks            Int            @default(0)

  @@unique([postId, url])
}

/// Ad spend per cohort and month, entered by hand on /admin/cohorts.
model CohortCost {
  id        String   @id @default(cuid())
  cohortKey String
  /// YYYY-MM
  month     String
  costCents Int
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([cohortKey, month])
}

/// One row per sync invocation; the cursor lets a long Beehiiv pass continue across cron runs.
model SubscriberSyncRun {
  id           String    @id @default(cuid())
  /// beehiiv_fsa | beehiiv_si | app
  source       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  pagesFetched Int       @default(0)
  rowsUpserted Int       @default(0)
  cursor       String?
  /// True when the pass reached the end of the list.
  completed    Boolean   @default(false)
  error        String?

  @@index([source, startedAt])
}

/// Where a LandingPage renders: the homepage hero (one row, slug "home") or an ad page at /go/<slug>.
enum LandingPageKind {
  HOME
  GO
}

enum LandingPageStatus {
  DRAFT // admins only, via /go/<slug>?preview=1
  LIVE
  ARCHIVED // 404 publicly; kept so lead rows keep their context
}

/// Admin-managed landing page. The copy fields are nullable overrides of the
/// code defaults in lib/lp/view.ts; headline and subheadline live on the
/// variants so they can be split-tested. Attribution is derived from the slug
/// (User.signupSource = "lp:<slug>", User.signupVariant = "<slug>:<key>").
model LandingPage {
  id              String            @id @default(cuid())
  slug            String            @unique
  kind            LandingPageKind   @default(GO)
  status          LandingPageStatus @default(DRAFT)
  templateSlug    String // AlertTemplate.slug shown as proof and auto-activated; ignored for HOME
  eyebrow         String?
  logicLine       String?
  bullets         String[]          @default([])
  ctaLabel        String?
  googleLabel     String?
  proofTitle      String?
  disclosure      String?
  afterSignupNote String?
  sampleAlert     Json? // SampleAlert shape (lib/lp/pages.ts); null = the strategy's own sample
  ogTitle         String?
  ogDescription   String?
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  variants        HeadlineVariant[]

  @@index([status])
}

/// One headline + subheadline candidate on a LandingPage. Visitors are bucketed
/// deterministically (lib/ab/pick.ts); weight 0 or isActive=false removes it from rotation.
model HeadlineVariant {
  id          String      @id @default(cuid())
  pageId      String
  page        LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key         String // "A".."Z"
  headline    String // "\n" marks a line break; the homepage renders the second line teal
  subheadline String
  weight      Int         @default(1)
  isActive    Boolean     @default(true)
  views       Int         @default(0) // counted by the browser beacon (POST /api/ab/view), bots filtered
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([pageId, key])
}

/// One AI-drafted FreeStockAlerts issue slot per day: the exclusion list for
/// topic picking and the idempotency key for the cron (lib/newsletter/build.ts).
model NewsletterIssue {
  id             String   @id @default(cuid())
  /// YYYY-MM-DD in America/Los_Angeles
  issueDate      String
  /// 1 | 2
  slot           Int
  /// pending | drafted | needs_review | failed | skipped
  status         String
  ticker         String?
  companyName    String?
  headline       String?
  subjectLine    String?
  previewText    String?
  /// "<TICKER>:<YYYY-MM-DD>:<slug>"
  eventKey       String?
  /// One sentence; fed back to the topic picker as an exclusion.
  eventSummary   String?
  /// [{ outlet, url }]
  sources        Json?
  /// Final paragraphs, "\n\n"-separated.
  articleText    String?
  reviewReason   String?
  /// The Smart Investor post the ads were copied from.
  tsiPostId      String?
  tsiPostTitle   String?
  tsiAdvertisers String?
  adsFound       Int      @default(0)
  /// The extracted ad HTML, for rebuilds and debugging.
  adsHtml        Json?
  beehiivPostId  String?
  beehiivPostUrl String?
  error          String?
  model          String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  webSearches    Int      @default(0)
  costUsd        Float    @default(0)
  forced         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([issueDate, slot])
  @@index([ticker, issueDate])
  @@index([createdAt])
}
