    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.0",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0"
  }
}
